# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection (SQLite by default for zero-config local run, can be PostgreSQL in production)
DATABASE_URL="file:./dev.db"

# JWT Security
JWT_SECRET=super_secret_dr_naseh_clinic_jwt_key_please_change_in_production_2026
JWT_EXPIRES_IN=7d

# CORS Configuration (Comma-separated allowed origins)
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=150
