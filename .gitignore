# ========================================================
# Git Ignore Configuration - Clinic Dr. Naseh Fullstack
# ========================================================

# Dependencies (Root, Frontend, Backend)
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Next.js & Build Outputs
.next/
out/
build/
dist/
*.tsbuildinfo
next-env.d.ts

# Environment & Sensitive Keys
.env
.env*.local
.env.development
.env.test
.env.production
backend/.env
frontend/.env.local

# Always keep example templates
!.env.example
!backend/.env.example
!frontend/.env.example

# Database & SQLite files
*.db
*.db-journal
*.sqlite
*.sqlite3
*.sqlite-journal
backend/prisma/dev.db

# Logs & Debugging
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Python caches
__pycache__/
*.py[cod]
*$py.class

# Testing & Coverage
coverage/
.nyc_output/

# Editor & OS Files
.vscode/
.idea/
*.swp
*.swo
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
Desktop.ini

# Vercel Deployment
.vercel/
